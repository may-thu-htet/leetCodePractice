/**
 * Definition for singly-linked list.
 * function ListNode(val, next) {
 *     this.val = (val===undefined ? 0 : val)
 *     this.next = (next===undefined ? null : next)
 * }
 */
/**
 * @param {ListNode} head
 * @return {void} Do not return anything, modify head in-place instead.
 */
var reorderList = function (head) {
  // find the middle
  let slow = head;
  let fast = head;
  while (fast.next != null && fast.next.next != null) {
    slow = slow.next;
    fast = fast.next.next;
  }
  // if(fast.next == null && fast == null){
  //     return slow;
  // }

  // seperate the two linkedlist
  let cur = slow.next;
  slow.next = null;
  // reverse the second linkedlist
  let prev = null;
  while (cur) {
    let temp = cur.next;
    cur.next = prev;
    prev = cur;
    cur = temp;
  }
  // reorder the two linkedlist
  let head1 = head;
  let head2 = prev;
  while (head1) {
    let temp = head1.next;
    head1.next = head2;
    head1 = head2;
    head2 = temp;
  }
};
