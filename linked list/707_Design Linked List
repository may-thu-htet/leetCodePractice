class ListNode {
  constructor(val) {
    this.val = val;
    this.next = null;
    this.prev = null;
  }
}
var MyLinkedList = function () {
  this.head = new ListNode(0);
  this.tail = new ListNode(0);
  this.head.next = this.tail;
  this.tail.prev = this.head;
};

/**
 * @param {number} index
 * @return {number}
 */
MyLinkedList.prototype.get = function (index) {
  let cur = this.head.next;
  while (cur && index > 0) {
    cur = cur.next;
    index--;
  }
  if (cur && index === 0 && cur != this.tail) {
    return cur.val;
  }
  return -1;
};

/**
 * @param {number} val
 * @return {void}
 */
MyLinkedList.prototype.addAtHead = function (val) {
  let node = new ListNode(val);
  let prev = this.head;
  let next = this.head.next;
  prev.next = node;
  next.prev = node;
  node.next = next;
  node.prev = prev;
};

/**
 * @param {number} val
 * @return {void}
 */
MyLinkedList.prototype.addAtTail = function (val) {
  let node = new ListNode(val);
  let prev = this.tail.prev;
  let next = this.tail;
  prev.next = node;
  next.prev = node;
  node.next = next;
  node.prev = prev;
};

/**
 * @param {number} index
 * @param {number} val
 * @return {void}
 */
MyLinkedList.prototype.addAtIndex = function (index, val) {
  let cur = this.head.next;
  while (cur && index > 0) {
    cur = cur.next;
    index--;
  }
  if (cur && index === 0) {
    let node = new ListNode(val);
    let prev = cur.prev;
    let next = cur;
    prev.next = node;
    next.prev = node;
    node.next = next;
    node.prev = prev;
  }
};

/**
 * @param {number} index
 * @return {void}
 */
MyLinkedList.prototype.deleteAtIndex = function (index) {
  let cur = this.head.next;
  while (cur && index > 0) {
    cur = cur.next;
    index--;
  }
  if (cur && index === 0 && cur != this.tail) {
    let prev = cur.prev;
    let next = cur.next;
    next.prev = prev;
    prev.next = next;
  }
};

